# Azure DevOps MCP Server - Environment Variables

# ── Required ──────────────────────────────────────────────────────────────────

# Azure DevOps Organization URL
# Cloud:   https://dev.azure.com/your-organization
# On-prem: https://your-server/tfs/YourCollection   (project is NOT part of this URL)
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-organization

# Authentication Method (defaults to 'azure-identity')
# Values: 'pat' | 'azure-identity' | 'azure-cli'
# Note: Azure DevOps Server (on-prem) supports 'pat' only
AZURE_DEVOPS_AUTH_METHOD=azure-identity

# Personal Access Token (required when AUTH_METHOD=pat)
# Create at: <org-url>/_usersSettings/tokens
# Required scopes: Code (Read), Build (Read), Project and Team (Read),
#                  Release (Read), Environment (Read), Variable Groups (Read)
AZURE_DEVOPS_PAT=your-personal-access-token

# ── Optional ──────────────────────────────────────────────────────────────────

# Default project name used when a tool call omits projectId
AZURE_DEVOPS_DEFAULT_PROJECT=your-default-project

# REST api-version for direct REST calls (default: 7.1)
# Lower this for older Azure DevOps Server versions (e.g. 6.0, 7.0)
# AZURE_DEVOPS_API_VERSION=7.1

# ── HTTP / Docker transport ───────────────────────────────────────────────────
# Only relevant when running src/http-server.ts (npm run start:http / Docker)

# TCP port the HTTP server listens on (default: 3000)
PORT=3000

# URL path for the MCP JSON-RPC endpoint (default: /mcp)
MCP_PATH=/mcp

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Azure Identity / Service Principal ───────────────────────────────────────
# Required only when AUTH_METHOD=azure-identity with a service principal
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret