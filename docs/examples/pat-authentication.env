# Example .env file for Personal Access Token (PAT) authentication
# Replace the values with your own

# Authentication method (required)
AZURE_DEVOPS_AUTH_METHOD=pat

# Azure DevOps collection URL (required)
# On-prem: https://your-server/tfs/YourCollection
AZURE_DEVOPS_ORG_URL=https://your-server/tfs/YourCollection

# Personal Access Token (required for PAT authentication)
# Create one at: <org-url>/_usersSettings/tokens
AZURE_DEVOPS_PAT=your-personal-access-token

# REST API version — lower this for older ADO Server versions (optional)
# ADO Server 2022 → 7.0 | 2020 → 6.0 | 2019 → 5.1
# AZURE_DEVOPS_API_VERSION=6.0

# ── MCP server security (HTTP transport only) ─────────────────────────────────

# Bearer token that every MCP client must supply in Authorization: Bearer <value>.
# Leave unset to keep the endpoint open.
# MCP_AUTH_TOKEN=your-secret-token

# Set to "true" to expose only read tools and block all write operations.
# MCP_READ_ONLY=false

# ── HTTP / Docker transport ───────────────────────────────────────────────────

# TCP port the HTTP server listens on (default: 3000)
# PORT=3000

# URL path for the MCP JSON-RPC endpoint (default: /mcp)
# MCP_PATH=/mcp

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
