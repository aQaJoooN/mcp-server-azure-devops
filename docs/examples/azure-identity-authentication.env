# Example .env file for Azure Identity (DefaultAzureCredential) authentication
# Replace the values with your own
# Note: Azure Identity authentication is supported for Azure DevOps Services only.

# Authentication method (required)
AZURE_DEVOPS_AUTH_METHOD=azure-identity

# Azure DevOps organization URL (required)
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-organization

# REST API version (optional, defaults to 7.1)
# AZURE_DEVOPS_API_VERSION=7.1

# Azure AD credentials — only required for service principal authentication.
# Not needed when using Managed Identity or Azure CLI login.
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret

# ── MCP server security (HTTP transport only) ─────────────────────────────────

# Bearer token that every MCP client must supply in Authorization: Bearer <value>.
# Leave unset to keep the endpoint open.
# MCP_AUTH_TOKEN=your-secret-token

# Set to "true" to expose only read tools and block all write operations.
# MCP_READ_ONLY=false

# ── HTTP / Docker transport ───────────────────────────────────────────────────

# TCP port the HTTP server listens on (default: 3000)
# PORT=3000

# URL path for the MCP JSON-RPC endpoint (default: /mcp)
# MCP_PATH=/mcp

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
